{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "@axiom-labs/arc-core": ["./packages/core/src/index.ts"],
      "@axiom-labs/arc-adapter-claude": ["./packages/adapter-claude/src/index.ts"]
    }
  },
  "include": [
    "src/index.ts",
    "src/cli.ts",
    "src/config.ts",
    "src/paths.ts",
    "src/shared.ts",
    "src/types.ts",
    "src/log.ts",
    "packages/core/src/**/*.ts",
    "packages/adapter-claude/src/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/cli/src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/*/dist"
  ]
}
