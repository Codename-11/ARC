{
  "name": "arccli",
  "version": "2.0.0",
  "type": "module",
  "description": "ARC — Agent Runtime Control. Unified CLI for managing profiles and environments for agent tools (Claude, Gemini, Codex, and more).",
  "main": "./dist/index.js",
  "bin": {
    "arc": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "dev:dash": "tsx src/index.ts dashboard",
    "dev:watch": "tsup --watch",
    "dev:rust": "cargo watch --manifest-path rust/Cargo.toml -c -q -x 'run --'",
    "dev:rust:tui": "cargo watch --manifest-path rust/Cargo.toml -c -q -x 'run -- dashboard'",
    "dev:rust:check": "cargo watch --manifest-path rust/Cargo.toml -c -q -x check",
    "build:rust": "cargo build --release --manifest-path rust/Cargo.toml",
    "cli": "node ./dist/index.js",
    "cli:dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "prepare": "tsup",
    "link:global": "pnpm build && pnpm link --global",
    "link:global:npm": "npm run build && npm link",
    "setup:local-bin": "npm run build && node scripts/setup-local-bin.js",
    "bootstrap:windows": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "bootstrap:unix": "bash scripts/bootstrap.sh",
    "unlink:global": "pnpm unlink --global",
    "version:set": "node scripts/version.js",
    "tag": "node scripts/tag.js",
    "tag:repush": "node scripts/tag.js --repush",
    "uninstall": "node scripts/uninstall.js",
    "uninstall:force": "node scripts/uninstall.js --force"
  },
  "keywords": [
    "cli",
    "agent",
    "claude",
    "claude-code",
    "gemini",
    "codex",
    "profile",
    "runtime",
    "ai",
    "terminal",
    "command-line",
    "arc"
  ],
  "author": "fmdz387",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codename-11/ARC.git"
  },
  "homepage": "https://github.com/Codename-11/ARC#readme",
  "bugs": {
    "url": "https://github.com/Codename-11/ARC/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "commander": "^13",
    "fullscreen-ink": "^0.1.0",
    "ink": "^6.8.0",
    "picocolors": "^1",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5.7"
  },
  "optionalDependencies": {
    "@inquirer/prompts": "^7",
    "@napi-rs/keyring": "^1"
  }
}
